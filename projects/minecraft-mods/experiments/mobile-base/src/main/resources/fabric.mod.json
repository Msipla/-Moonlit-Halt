{
  "schemaVersion": 1,
  "id": "mobilebase",
  "version": "${version}",
  "name": "移动基地装配器",
  "description": "使用 Valkyrien Skies 和 Eureka，把玩家建造的结构装配成船。",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.mispla.mobilebase.MobileBase"],
    "client": ["dev.mispla.mobilebase.MarkerClient"]
  },
  "mixins": ["mobilebase.mixins.json"],
  "depends": {
    "java": ">=17",
    "minecraft": "1.20.1",
    "fabricloader": ">=0.17.2",
    "fabric-api": "*",
    "valkyrienskies": "=2.4.10",
    "vs_eureka": "=1.6.3"
  }
}
